# Keep this file limited to settings the game scheduler requires.
# Copy it to .scheduler.env and use the corresponding values from backend/.env.
# Compose supplies REDIS_URL from the root infrastructure REDIS_PASSWORD.
PGHOST=postgres-host
PGUSER=confessit
PGPORT=5432
PGDATABASE=ConfessIt
PGPASSWORD=replace-with-database-password
SECRET_KEY=replace-with-the-backend-secret-key
TOKEN_HASH_PEPPER=replace-with-the-backend-token-hash-pepper
CHAT_CLEANUP_BATCH_SIZE=500
