# Test-only image for docker-compose.test.yml. The build context is the repo root,
# not ./backend: backend/.dockerignore excludes tests/ (production images must not
# ship them), whereas the root .dockerignore keeps the suite available while still
# excluding .env files and caches.
#
# The tree mirrors the repository (/workspace/backend plus /workspace/observability)
# because a few tests resolve repository files relative to the test file.
FROM python:3.12.15-slim-bookworm

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY backend/requirements.txt backend/requirements-dev.txt ./

RUN pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir -r requirements-dev.txt

# Only what the suite imports; .env and logs stay out of the image.
COPY backend/app ./backend/app
COPY backend/tests ./backend/tests
COPY backend/assets ./backend/assets
COPY backend/scripts ./backend/scripts
COPY backend/seed_db.py ./backend/
COPY observability ./observability

RUN useradd -r -m tester \
    && chown -R tester:tester /workspace

WORKDIR /workspace/backend
USER tester

CMD ["python", "-m", "pytest", "--strict-markers", "tests"]
