# Database connection
# Hostname of the PostgreSQL server.
PGHOST=
# PostgreSQL login name.
PGUSER=
# PostgreSQL server port.
PGPORT=
# Database name to connect to.
PGDATABASE=
# Password for the PostgreSQL login.
PGPASSWORD=
# TLS mode used for the PostgreSQL connection (for example, require).
PGSSLMODE=

# Backend security and tokens
# Secret used to sign and validate application tokens.
SECRET_KEY=
# Secret pepper used when hashing tokens; keep consistent across backend workers.
TOKEN_HASH_PEPPER=

# Chat encryption and retention
# Version label of the key used for new encrypted chat data (for example, v1).
CHAT_ENCRYPTION_ACTIVE_KEY_VERSION=
# Base64-encoded 32-byte encryption key for key version v1.
CHAT_ENCRYPTION_KEY_V1=
# Number of hours matchmaking chat history is retained.
MATCHMAKING_CHAT_RETENTION_HOURS=
# Number of days reported-message evidence is retained.
REPORTED_MESSAGE_EVIDENCE_RETENTION_DAYS=
# Maximum records processed by one chat cleanup batch.
CHAT_CLEANUP_BATCH_SIZE=

# Redis and deployment
# Connection URL for the Redis instance used by the backend.
REDIS_URL=
# Cloud or deployment platform identifier used by backend configuration.
# Public base URL for links and externally reachable backend routes.
PUBLIC_BASE_URL=

# User and upload limits
# Maximum number of regular users allowed by the application.
MAX_USER_COUNT=
# Maximum number of administrators allowed by the application.
MAX_ADMIN_COUNT=
# Maximum number of moderators allowed by the application.
MAX_MODERATOR_COUNT=
# Maximum allowed image upload size in megabytes.
MAX_IMAGE_SIZE_MB=

# Cloudinary image storage
# Cloudinary account cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary account API key.
CLOUDINARY_API_KEY=
# Cloudinary account API secret.
CLOUDINARY_API_SECRET=
# Optional Cloudinary connection URL containing account credentials.
CLOUDINARY_URL=
# Comma-separated image formats accepted for upload.
CLOUDINARY_ALLOWED_FORMATS=

# Language model and embeddings
# Language model provider name.
LLM_PROVIDER=
# API key for the configured language model provider.
LLM_API_KEY=
# Base URL for the language model API.
LLM_BASE_URL=
# Model identifier sent to the language model API.
LLM_MODEL=
# Endpoint URL for generating text embeddings.
EMBEDDING_ENDPOINT=
# API key for the embedding service.
EMBEDDING_API_KEY=
# Embedding model identifier.
EMBEDDING_MODEL=
# Number of dimensions returned by the embedding model.
EMBEDDING_DIMENSIONS=
# Whether embedding-based search is enabled.
EMBEDDING_SEARCH_ENABLED=

# Content safety and PII detection
# API key for the content safety service.
CONTENT_SAFETY_API_KEY=
# Endpoint URL for the content safety service.
CONTENT_SAFETY_ENDPOINT=
# Service region for content safety requests.
CONTENT_SAFETY_REGION=
# Content safety request timeout in seconds.
CONTENT_SAFETY_TIMEOUT_SECONDS=
# API key for the PII detection service.
PII_DETECTION_API_KEY=
# Endpoint URL for the PII detection service.
PII_DETECTION_ENDPOINT=
# Service region for PII detection requests.
PII_DETECTION_REGION=

# Email integration
# URL of the email sending function or service.
EMAIL_FUNCTION_URL=
