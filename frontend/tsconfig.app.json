{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022 library on an ES2020 emit target: the code may use `.at()` and friends
    // (present in every supported runtime -- Node 22, evergreen browsers) while the
    // emitted JavaScript stays at the previous level. Widening `lib` only adds known
    // APIs; it removes no checking.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    // Host-run tests (observability wiring reads repo files from disk) import
    // Node builtins. @types/node is installed but not otherwise in this
    // compilation's graph, so name it explicitly per the compiler's own hint.
    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"]
}
