# Example production Nginx front for the ConfessIt SPA. Copy, fill the three
# placeholders (SERVER_NAME, API_ORIGIN, certificate paths), and serve the
# `vite build` output from it -- do NOT serve production from `vite dev`.
#
# What this enforces that the dev server cannot: TLS with HSTS, the full
# Content-Security-Policy (dev Vite needs inline scripts and eval for HMR, so a dev
# CSP is either broken or `unsafe-*` theatre), and framing protection that actually
# binds (frame-ancestors is ignored in <meta>, so it only works as a header).
#
# CSP shape rationale -- change a source only if you know what loads from where:
# * script/style: first-party only (the bundle; no inline handlers anywhere);
# * fonts: Google Fonts, which index.css @imports;
# * images: self, data:/blob: (previews), Cloudinary delivery, and the matchmaking
#   slot-machine placeholders -- drop placehold.co if those mocks ever go away;
# * media: self plus Cloudinary (delivery URLs can serve video renditions);
# * connect: self plus the API origin over https and wss (REST + chat socket).
# Everything else -- objects, frames, form targets, base URIs -- has no legitimate
# source and is closed outright.
#
# If the API lives on its own host instead of under /api/, point API_ORIGIN at it in
# VITE_API_URL at build time AND in the connect-src below, keep the same CSP, and
# delete the /api/ location. Either way the API origin must be https: the frontend
# refuses a non-https VITE_API_URL at build time (see scripts/check-prod-env.mjs).

# If the API lives on its own host instead of under /api/, replace every API_ORIGIN
# below with that https origin (and build with it as VITE_API_URL), keep the same CSP,
# and delete the /api/ location. Either way the API origin must be https: the frontend
# refuses a non-https VITE_API_URL at build time (see scripts/check-prod-env.mjs).

server {
    listen 443 ssl http2;
    server_name SERVER_NAME;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;

    # TLS is the only way in: HSTS (the backend also sends it, this covers statics).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://placehold.co; media-src 'self' https://res.cloudinary.com; connect-src 'self' https://API_ORIGIN wss://API_ORIGIN; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # The SPA is one document: deep links fall back to it, hashed assets cache forever.
    location / {
        try_files $uri $uri/ /index.html;
    }
    location ~* \.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # Same-origin API under /api/: with this layout build with
    # VITE_API_URL=https://SERVER_NAME/api so calls land here. Forward the client
    # address and proto so the backend's proxy-aware pieces (Secure
    # cookies, rate-limit IP, TrustedHost check) see the browser, not this proxy --
    # and list this host in the backend's TRUSTED_PROXY_HOSTS.
    location /api/ {
        proxy_pass http://backend:8001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Plain HTTP exists only to leave it: every request moves to https without being served.
server {
    listen 80;
    server_name SERVER_NAME;
    return 301 https://$host$request_uri;
}
