# Same reason as the backend one: the context is ./frontend, so the repo-root
# .dockerignore does not apply to this build. `COPY . .` would otherwise bake the host's
# node_modules (565 MB, installed for the host platform and already shadowed by the npm
# install layer) and .env into the image. Vite reads .env from /app at run time, where the
# bind mount in docker-compose.dev.yml supplies it.
node_modules
**/node_modules
dist
.env
*/.env
.git

# Test and manual check files are not needed in Docker build contexts. The dev
# Compose bind mount still exposes them locally; production emits only dist/.
tests/
bun.lockb
scripts/contrast-check.mjs
