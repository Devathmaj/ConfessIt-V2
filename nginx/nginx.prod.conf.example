# Production Nginx front for the ConfessIt SPA.
#
# Used two ways: read it as the documented production edge, and used verbatim by
# frontend/Dockerfile, which copies it as the container's Nginx template --
# nginx:alpine renders `${...}` from the environment at container start, so
# SERVER_NAME/API_ORIGIN arrive as container env (see docker-compose.yml), not
# edits. Do NOT serve production from `vite dev`.
#
# What this enforces that the dev server cannot: TLS with HSTS, the full
# Content-Security-Policy (dev Vite needs inline scripts and eval for HMR, so a dev
# CSP is either broken or `unsafe-*` theatre), and framing protection that actually
# binds (frame-ancestors is ignored in <meta>, so it only works as a header).
#
# CSP shape rationale -- change a source only if you know what loads from where:
# * script/style: first-party only (the bundle; no inline handlers anywhere);
# * fonts: Google Fonts, which index.css @imports;
# * images: self, data:/blob: (previews), Cloudinary delivery, and the matchmaking
#   slot-machine placeholders -- drop placehold.co if those mocks ever go away;
# * media: self plus Cloudinary (delivery URLs can serve video renditions);
# * connect: self plus the API origin over https and wss (REST + chat socket).
# Everything else -- objects, frames, form targets, base URIs -- has no legitimate
# source and is closed outright. TLS certificates arrive as a mounted directory
# (/etc/nginx/tls); without them Nginx fails to start, loudly, rather than serving
# plain HTTP by accident. Rate limiting sits beside the proxy: abusive volume never
# reaches the app. A WAF (e.g. ModSecurity) is deliberately not bundled -- add one
# here if the threat model needs it.
#
# If the API lives on its own host instead of under /api/, set API_ORIGIN to that
# host (and build with https://API_ORIGIN as VITE_API_URL), keep the same CSP, and
# delete the /api/ location. With the /api/ layout below, API_ORIGIN is this same
# host. Either way the API origin must be https: the frontend refuses a non-https
# VITE_API_URL at build time (see scripts/check-prod-env.mjs).

# Access log with latency and status for every request the edge serves or proxies.
# The request line is logged WITHOUT the query string (`$request_method $uri`
# rather than `$request`): bearer tokens travel in query strings here -- the
# chat socket authenticates as `/messages/ws/<id>?token=...` and magic links
# verify as `?token=...` -- and a retained edge log must never hold live
# credentials. `$uri` is the normalized path with args stripped.
log_format confessit '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                      '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                      'rt=$request_time uct="$upstream_connect_time" urt="$upstream_response_time"';

# One shared abuse budget per client address before requests reach any location.
# The server-level limit applies to every proxied or file-served endpoint,
# including static assets and any location added later; the / and /api/
# locations below apply their own, slightly larger bursts (a cold page load is
# many requests, and chat is long-lived but only the handshake is counted).
# /healthz is a local return and deliberately sits outside the budget.
limit_req_zone $binary_remote_addr zone=edge:10m rate=30r/s;
limit_req_status 429;

# Preserve the WebSocket handshake for the chat sockets tunnelled through
# /api/ (and keep ordinary requests from claiming an upgrade).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log confessit;
    server_tokens off;

    # The largest legitimate body is a base64 love-note image or the bulk
    # upload (10 MiB); the backend enforces the precise ceiling.
    client_max_body_size 20m;

    # Belt and braces: every request starts with the edge budget. Locations
    # that declare their own limit_req override it for that path only.
    limit_req zone=edge burst=120 nodelay;

    # TLS is the only way in: HSTS (the backend also sends it, this covers statics).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://placehold.co; media-src 'self' https://res.cloudinary.com; connect-src 'self' https://${API_ORIGIN} wss://${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # The SPA is one document: deep links fall back to it, hashed assets cache forever.
    location / {
        limit_req zone=edge burst=60 nodelay;
        try_files $uri $uri/ /index.html;
    }
    # Local liveness probe for Compose; never proxied to the application.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
    # Floral artwork: stable unhashed filenames whose content never changes
    # without a deploy, so they cache for a year as immutable. `^~` pins this
    # prefix ahead of the extension regex below, so the rule survives future
    # regex edits rather than depending on incidental `.svg` coverage.
    location ^~ /floral_svgs/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        # SVG is text: gzip collapses the branches ~70-80% on the wire, which
        # is most of the cold-load wait. (nginx:alpine needs an extra module
        # for brotli, so gzip is the portable choice.)
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_comp_level 6;
        gzip_types image/svg+xml;
    }
    location ~* \.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # Same-origin API under /api/: with this layout build with
    # VITE_API_URL=https://${SERVER_NAME}/api so calls land here. Forward the client
    # address and proto so the backend's proxy-aware pieces (Secure
    # cookies, rate-limit IP, TrustedHost check) see the browser, not this proxy --
    # and list this host in the backend's TRUSTED_PROXY_HOSTS.
    location /api/ {
        limit_req zone=edge burst=100 nodelay;
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite rather than append: this edge is the public hop, so a
        # client-supplied X-Forwarded-For must not become the address the
        # backend's rate limiter reads. If another trusted proxy is placed in
        # front of this container, configure real_ip and append here instead.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The chat socket (`/messages/ws/<id>`) tunnels through this same
        # location: without an HTTP/1.1 Upgrade handshake the proxy answers
        # the upgrade request as plain HTTP and the socket never opens.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Chat sockets stay open across long idle periods.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Plain HTTP exists only to leave it: every request moves to https without being served.
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Compose healthcheck: it must answer on plain HTTP even though every
    # other request is redirected, otherwise the probe follows a redirect into
    # TLS and fails on the certificate/hostname it cannot validate locally.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
